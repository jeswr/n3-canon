{
  "name": "n3-canon",
  "version": "0.0.0-development",
  "description": "RDF Dataset Canonicalization (RDFC-1.0) for N3.js stores: the toCanonical method of the RDF/JS Dataset interface",
  "keywords": [
    "rdf",
    "rdfjs",
    "n3",
    "canonicalization",
    "rdf-canon",
    "rdfc-1.0",
    "c14n",
    "n-quads"
  ],
  "license": "MIT",
  "author": "Jesse Wright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeswr/n3-canon.git"
  },
  "bugs": "https://github.com/jeswr/n3-canon/issues",
  "homepage": "https://github.com/jeswr/n3-canon#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "src",
    "index.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 'test/*.test.js'",
    "lint": "eslint . && tsc --noEmit -p test/types",
    "spec": "node spec/w3c.js",
    "bench": "node bench/bench.js"
  },
  "peerDependencies": {
    "n3": "^2.0.0 || ^3.0.0-alpha.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "n3": "^2.13.10",
    "rdf-canonize": "^5.0.0",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "dependencies": {
    "@rdfjs/types": "^2.0.1",
    "@types/n3": "^1.26.4"
  }
}
